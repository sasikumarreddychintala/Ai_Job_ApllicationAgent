# Local Agent Settings
ENV=development
DRY_RUN=true
DAILY_APPLICATION_LIMIT=10
MIN_MATCH_SCORE=70
LOG_LEVEL=INFO

# Database Settings (sqlite or postgres)
DATABASE_TYPE=sqlite
DATABASE_PATH=data/applications.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/job_agent

# AI Cloud Engines & Local Models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=60

# Playwright Browser Config
HEADLESS=false
SLOW_MO=500
BROWSER_TIMEOUT=30000

# File Paths
MASTER_RESUME_PATH=data/master_resume/resume.pdf
CANDIDATE_PROFILE_PATH=data/candidate_profile.json
TAILORED_RESUMES_DIR=data/tailored_resumes/
LOGS_DIR=data/logs/

# Mobile Notifications (Telegram & Discord)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=80
DISCORD_WEBHOOK_URL=

# Cold Email Outreach (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Your Name"

# Live Application Trackers (Google Sheets & Notion)
GOOGLE_SHEETS_WEBHOOK_URL=
NOTION_API_KEY=
NOTION_DATABASE_ID=
